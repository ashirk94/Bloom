{
  "name": "bloom",
  "private": true,
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon --watch server.js --watch config --watch models --watch routes --watch utilities server.js",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "node server.js",
    "test": "jest",
    "migrate": "node scripts/migrate.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/client/"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-mongo": "^6.0.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "mongoose": "^9.12.1",
    "multer": "^2.5.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14"
  }
}
